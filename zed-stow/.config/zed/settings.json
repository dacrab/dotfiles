{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "ssh_connections": [
    {
      "host": "mc-vps",
      "args": [],
      "projects": []
    }
  ],
  "icon_theme": "Material Icon Theme",
  "ui_font_family": "GeistMono Nerd Font Mono",
  "terminal": {
    "font_size": 12.0
  },
  "base_keymap": "VSCode",
  "preview_tabs": {
    "enabled": false
  },
  "tab_bar": {
    "show": true
  },
  "minimap": {
    "show": "auto"
  },
  "cursor_blink": true,
  "autosave": "on_focus_change",
  "buffer_font_family": "GeistMono Nerd Font Propo",
  "soft_wrap": "editor_width",
  "edit_predictions": {
    "disabled_globs": [
      "**/.env",
      "**/.env.*",
      "**/credentials.json",
      "**/credentials.*.json",
      "**/secret.json",
      "**/secrets.json",
      "**/*.key",
      "**/*.pem",
      "**/*.pfx",
      "**/*.p12",
      "**/*.crt",
      "**/*.cer",
      "**/id_rsa",
      "**/id_dsa",
      "**/.ssh/id_*",
      "**/.meta"
    ]
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  }
}

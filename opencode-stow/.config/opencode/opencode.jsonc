{
  "$schema": "https://opencode.ai/config.json",
  "mode": {
    "plan": {},
    "build": {}
  },
  "policies": [
    // Drop the AgentRouter catalog provider and all of its models.
    { "action": "provider.use", "resource": "agentrouter", "effect": "deny" }
  ],
  "providers": {
    "river": {
      "name": "River",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.river.ai/v1",
        "apiKey": "{env:RIVER_API_KEY}"
      },
      "models": {
        "zai-org/GLM-5.3-Flash": {
          "name": "GLM 5.3 Flash (River)"
        },
        "deepseek-ai/DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017 (River)",
          "capabilities": { "tools": true }
        }
      }
    },
    "explabs": {
      "name": "Experiential Labs",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{file:~/.secrets/explabs-api-key}"
      },
      "models": {
        "glm-5.3-uncensored": {
          "name": "GLM 5.3 Uncensored",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "capabilities": {
            "tools": true,
            "temperature": true,
            "reasoning": { "supported": false }
          },
          "cost": {
            "input": 1.4,
            "output": 4.4,
            "cache": { "read": 0.26 }
          }
        }
      }
    }
  }
}

#!/usr/bin/env bash
# display - toggle/enable/disable the built-in panel (default: eDP-*).
set -uo pipefail

BUILTIN="${BUILTIN_PREFIX:-eDP-}"
RES="${DISPLAY_RES:-1920x1080@60}"

mon() { hyprctl monitors all | awk -v p="$BUILTIN" '/^Monitor/{if ($2 ~ p) print $2}'; }

case "${1:-}" in
  toggle)  hyprctl keyword monitor "$(mon),toggle" ;;
  enable)  hyprctl keyword monitor "${2:-$(mon)},$RES,0x0,1" ;;
  disable) hyprctl keyword monitor "${2:-$(mon)},disable" ;;
  *) echo "usage: $0 {toggle|enable [mon]|disable [mon]}"; exit 1 ;;
esac
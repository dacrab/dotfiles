#!/usr/bin/env bash
# display - toggle/enable/disable the built-in panel (default: eDP-*).
set -uo pipefail

BUILTIN="${BUILTIN_PREFIX:-eDP-}"
RES="${DISPLAY_RES:-1920x1080@60}"

usage() {
  printf 'usage: %s {toggle [mon]|enable [mon]|disable [mon]}\n' "$0"
}

error() {
  printf 'display: %s\n' "$*" >&2
}

(($# >= 1)) || {
  usage >&2
  exit 1
}
ACTION=$1
shift
case "$ACTION" in
  toggle | enable | disable) ;;
  *)
    usage >&2
    exit 1
    ;;
esac
if (($# > 1)); then
  usage >&2
  exit 2
fi
REQUESTED=${1:-}

command -v jq >/dev/null 2>&1 || {
  error "jq is required"
  exit 1
}

MONITORS=$(hyprctl -j monitors all) || {
  error "failed to query monitors"
  exit 1
}

if [[ -n "$REQUESTED" ]]; then
  jq -e --arg name "$REQUESTED" 'map(select(.name == $name)) | length == 1' <<<"$MONITORS" >/dev/null || {
    error "monitor not found: $REQUESTED"
    exit 1
  }
  MONITOR=$REQUESTED
else
  mapfile -t BUILTINS < <(
    jq -r --arg prefix "$BUILTIN" '.[] | select(.name | startswith($prefix)) | .name' <<<"$MONITORS"
  )
  ((${#BUILTINS[@]} == 1)) || {
    error "expected exactly one monitor matching $BUILTIN, found ${#BUILTINS[@]}"
    exit 1
  }
  MONITOR=${BUILTINS[0]}
fi

STATE=$(jq -r --arg name "$MONITOR" 'map(select(.name == $name)) | if length == 1 then .[0].disabled else empty end' <<<"$MONITORS") || {
  error "failed to read monitor state"
  exit 1
}
[[ "$STATE" == true || "$STATE" == false ]] || {
  error "monitor has no boolean disabled state: $MONITOR"
  exit 1
}

lua_string() {
  jq -rn --arg value "$1" '$value | @json'
}

MONITOR_JSON=$(lua_string "$MONITOR") || {
  error "failed to encode monitor name"
  exit 1
}

case "$ACTION" in
  toggle)
    if [[ "$STATE" == true ]]; then
      DESIRED=false
    else
      DESIRED=true
    fi
    LUA="hl.monitor({ output = $MONITOR_JSON, disabled = $DESIRED })"
    ;;
  enable)
    RES_JSON=$(lua_string "$RES") || {
      error "failed to encode display mode"
      exit 1
    }
    LUA="hl.monitor({ output = $MONITOR_JSON, mode = $RES_JSON, position = \"0x0\", scale = 1, disabled = false })"
    ;;
  disable)
    LUA="hl.monitor({ output = $MONITOR_JSON, disabled = true })"
    ;;
esac

hyprctl eval "$LUA" || {
  error "hyprctl eval failed"
  exit 1
}

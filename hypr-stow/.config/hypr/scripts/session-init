#!/usr/bin/env bash
set -euo pipefail

# Keyring: PAM (via GDM) already starts and unlocks gnome-keyring-daemon.
# We just need to ensure the environment is propagated to the session.
setup_keyring() {
  # If gnome-keyring-daemon is already running (started by PAM), use it
  if pgrep -x gnome-keyring-daemon >/dev/null 2>&1; then
    export GNOME_KEYRING_CONTROL="/run/user/$(id -u)/keyring"
    export SSH_AUTH_SOCK="/run/user/$(id -u)/keyring/ssh"
  elif command -v gnome-keyring-daemon >/dev/null 2>&1; then
    eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null || true)"
  fi
  # Export to Hyprland so child processes inherit it
  [ -n "${SSH_AUTH_SOCK:-}" ] && hyprctl keyword env "SSH_AUTH_SOCK,${SSH_AUTH_SOCK}" >/dev/null 2>&1 || true
}

start_polkit() {
  local agents=(
    hyprpolkitagent
    /usr/libexec/polkit-gnome-authentication-agent-1
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
    /usr/lib/polkit-kde-authentication-agent-1
    lxqt-policykit-agent
  )
  for agent in "${agents[@]}"; do
    if command -v "$agent" >/dev/null 2>&1 || [[ -x "$agent" ]]; then
      pgrep -f "$(basename "$agent")" >/dev/null 2>&1 || "$agent" &
      return
    fi
  done
}

propagate_env() {
  dbus-update-activation-environment --systemd \
    DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP \
    GNOME_KEYRING_CONTROL SSH_AUTH_SOCK 2>/dev/null || true
}

setup_keyring
start_polkit
propagate_env

exit 0

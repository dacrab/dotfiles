#!/usr/bin/env bash
set -euo pipefail

if pgrep -x gnome-keyring-daemon &>/dev/null; then
  export GNOME_KEYRING_CONTROL="/run/user/$(id -u)/keyring"
  export SSH_AUTH_SOCK="/run/user/$(id -u)/keyring/ssh"
elif command -v gnome-keyring-daemon &>/dev/null; then
  eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null || true)"
fi
[ -n "${SSH_AUTH_SOCK:-}" ] && hyprctl keyword env "SSH_AUTH_SOCK,${SSH_AUTH_SOCK}" &>/dev/null || true

for agent in hyprpolkitagent /usr/libexec/polkit-gnome-authentication-agent-1 /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/lib/polkit-kde-authentication-agent-1 lxqt-policykit-agent; do
  command -v "$agent" &>/dev/null || [[ -x "$agent" ]] || continue
  pgrep -f "$(basename "$agent")" &>/dev/null || "$agent" &
  break
done

dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP GNOME_KEYRING_CONTROL SSH_AUTH_SOCK &>/dev/null || true
systemctl --user start xdg-desktop-portal-hyprland xdg-desktop-portal &>/dev/null || true

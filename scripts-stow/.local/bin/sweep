#!/usr/bin/env bash
# sweep - portable cache/junk cleaner; see `sweep --help`.
set -uo pipefail
shopt -s nullglob

DRY=""
usage() {
  cat <<'EOF'
sweep - portable cache/junk cleaner, topgrade-style.
Detects what is installed and cleans only that, skipping the rest.

Usage: sweep [-n|--dry-run] [-h|--help]

Env overrides (see dotfiles/README.md "Helper scripts"):
  SWEEP_TRASH_DAYS      purge trash older than N days (default 7, 0 disables)
  SWEEP_JOURNAL_AGE     journalctl --vacuum-time value (default 3d)
  SWEEP_COREDUMP_DAYS   delete coredumps older than N days (default 7)
  SWEEP_CONTAINERS      1 = prune docker/podman (default off)
  SWEEP_FLATPAK_UNUSED  1 = flatpak uninstall --unused (default 1, 0 disables)
  SWEEP_PROJECTS        colon-separated roots to scan for build artifacts
                        (default empty, so no project scan)
EOF
}

if (($# > 1)); then
  echo "sweep: too many arguments (try --help)" >&2
  exit 2
fi
case "${1:-}" in
  -n | --dry-run) DRY=1 ;;
  -h | --help) usage; exit 0 ;;
  "") ;;
  *)
    echo "sweep: unknown option: $1 (try --help)" >&2
    exit 2
    ;;
esac

TRASH_DAYS="${SWEEP_TRASH_DAYS:-7}"
JOURNAL_AGE="${SWEEP_JOURNAL_AGE:-3d}"
COREDUMP_DAYS="${SWEEP_COREDUMP_DAYS:-7}"
CONTAINERS="${SWEEP_CONTAINERS:-0}"
FLATPAK_UNUSED="${SWEEP_FLATPAK_UNUSED:-1}"
PROJECTS="${SWEEP_PROJECTS:-}"

[[ "$TRASH_DAYS" =~ ^[0-9]+$ ]] \
  || { echo "sweep: SWEEP_TRASH_DAYS must be a non-negative integer" >&2; exit 2; }
[[ "$COREDUMP_DAYS" =~ ^[0-9]+$ ]] \
  || { echo "sweep: SWEEP_COREDUMP_DAYS must be a non-negative integer" >&2; exit 2; }

has() { command -v "$1" &>/dev/null; }

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"

FAILED=0
CLEAN_TARGETS=()
declare -A SEEN=()

# Roots that must never be removed, even if a variable expands wrongly.
PROTECTED=("$HOME" "$CACHE" "$DATA" "/")

section() { printf '\n==> %s\n' "$*"; }

# Queue a path for removal at the end (dry-run just lists it). Existence is
# rechecked at removal time, so a child queued under an already-removed parent
# is silently skipped instead of failing.
clean() {
  local target=${1%/}
  [[ -n "$target" ]] || target=/
  [[ -e "$target" || -L "$target" ]] || return 0
  local p
  for p in "${PROTECTED[@]}"; do
    if [[ "$target" == "$p" ]]; then
      echo "sweep: refusing to clean $target" >&2
      FAILED=1
      return 1
    fi
  done
  [[ -n "${SEEN[$target]:-}" ]] && return 0
  SEEN[$target]=1
  CLEAN_TARGETS+=("$target")
}

clean_targets() {
  local target
  ((${#CLEAN_TARGETS[@]})) && [[ -n "$DRY" ]] && section "removal plan"
  for target in "${CLEAN_TARGETS[@]}"; do
    [[ -e "$target" || -L "$target" ]] || continue
    if [[ -n "$DRY" ]]; then
      printf '  rm -rf -- %q\n' "$target"
    elif ! rm -rf -- "$target"; then
      FAILED=1
    fi
  done
}

run() {
  if [[ -n "$DRY" ]]; then
    printf '  %s\n' "$*"
    return 0
  fi
  "$@" || { FAILED=1; return 1; }
}

as_root() {
  if [[ $EUID -eq 0 ]]; then
    run "$@"
  elif has sudo; then
    run sudo "$@"
  elif [[ -n "$DRY" ]]; then
    printf '  (needs root) %s\n' "$*"
  else
    echo "sweep: cannot run $1 without root or sudo" >&2
    FAILED=1
    return 1
  fi
}

clean_pkg_caches() {
  section "package manager caches"
  has apt-get && as_root apt-get clean
  has dnf && as_root dnf clean all -q
  has pacman && as_root pacman -Sc --noconfirm
  has zypper && as_root zypper clean -a
  has brew && run brew cleanup -s
}

# Remove disabled snap revisions (columns: Name Version Rev Tracking ...).
clean_stale_snaps() {
  local name rev tracking
  has snap || return 0
  while read -r name _version rev tracking _rest; do
    [[ "$name" == "Name" || -z "$name" ]] && continue
    [[ "$tracking" == "disabled" ]] && as_root snap remove "$name" "--revision=$rev"
  done < <(snap list --all 2>/dev/null)
}

clean_logs() {
  section "system logs and crash dumps"
  has journalctl && as_root journalctl --vacuum-time="$JOURNAL_AGE"
  [[ -d /var/lib/systemd/coredump ]] \
    && as_root find /var/lib/systemd/coredump -maxdepth 1 -type f -mtime +"$COREDUMP_DAYS" -delete
}

# Used only when trash-cli is absent (gio has no age filter).
purge_trash_fallback() {
  local trash_base="$DATA/Trash"
  [[ -d "$trash_base/files" ]] || return 0
  if [[ -n "$DRY" ]]; then
    printf '  find %s/files %s/info -mindepth 1 -maxdepth 1 -mtime +%s -exec rm -rf {} +\n' \
      "$trash_base" "$trash_base" "$TRASH_DAYS"
    return 0
  fi
  find "$trash_base/files" -mindepth 1 -maxdepth 1 -mtime +"$TRASH_DAYS" -exec rm -rf {} + \
    || { FAILED=1; return 1; }
  find "$trash_base/info" -mindepth 1 -maxdepth 1 -mtime +"$TRASH_DAYS" -delete 2>/dev/null
}

clean_trash() {
  [[ "$TRASH_DAYS" == 0 ]] && return 0
  if has trash-empty; then
    run trash-empty -f "$TRASH_DAYS"
  else
    purge_trash_fallback
  fi
}

# Caches are regenerable by definition, so wipe the whole XDG cache directory
# instead of keeping a list of application-specific subdirectories.
clean_user_cache() {
  local entry
  section "user cache"
  for entry in "$CACHE"/* "$CACHE"/.[!.]* "$CACHE"/..?*; do
    clean "$entry"
  done
}

# Tool commands also cover caches stored outside XDG_CACHE_HOME.
clean_lang_caches() {
  section "language and runtime caches"
  has npm && run npm cache clean --force --silent
  has pnpm && run pnpm store prune
  has yarn && run yarn cache clean
  has pip && run pip cache purge
  has uv && run uv cache clean
  has go && run go clean -cache
  has poetry && run poetry cache clear . --all --no-interaction
  has cargo && has cargo-cache && run cargo cache --autoclean
  has dotnet && run dotnet nuget locals all --clear
  local gradle="${GRADLE_USER_HOME:-$HOME/.gradle}"
  clean "$gradle/caches"
  clean "$gradle/daemon"
  clean "${BUN_INSTALL:-$HOME/.bun}/install/cache"
}

clean_flatpak() {
  local dir
  section "flatpak"
  has flatpak || return 0
  for dir in "$HOME/.var/app/"*/cache; do
    clean "$dir"
  done
  [[ "$FLATPAK_UNUSED" == 1 ]] && run flatpak uninstall --unused -y
}

# Optional project scan: only removes directories whose sibling manifest proves
# they are generated, so a source tree named "build" or "target" is left alone.
clean_projects() {
  local root dir parent
  [[ -n "$PROJECTS" ]] || return 0
  section "project build artifacts"
  local IFS=:
  for root in $PROJECTS; do
    root=${root/#\~/$HOME}
    [[ -d "$root" ]] || continue
    while IFS= read -r -d '' dir; do
      parent=${dir%/*}
      case ${dir##*/} in
        target)
          [[ -f "$parent/Cargo.toml" || -f "$parent/pom.xml" ]] || continue
          ;;
        node_modules | .next | .svelte-kit | .turbo | .parcel-cache | .vite)
          [[ -f "$parent/package.json" ]] || continue
          ;;
        Library | Temp | Obj | Logs)
          [[ -d "$parent/Assets" && -d "$parent/ProjectSettings" ]] || continue
          ;;
        build | .gradle | .kotlin)
          [[ -e "$parent/build.gradle" || -e "$parent/build.gradle.kts" \
            || -e "$parent/settings.gradle" || -e "$parent/settings.gradle.kts" \
            || -e "$parent/pom.xml" || -e "$parent/gradlew" ]] || continue
          ;;
        __pycache__ | .pytest_cache | .mypy_cache | .ruff_cache) ;;
        *) continue ;;
      esac
      clean "$dir"
    done < <(find "$root" -mindepth 1 -maxdepth 6 \
      \( -name .git -o -name target -o -name node_modules \
      -o -name Library -o -name Temp -o -name Obj -o -name Logs \
      -o -name build -o -name .gradle -o -name .kotlin -o -name .next \
      -o -name .svelte-kit -o -name .turbo -o -name .parcel-cache \
      -o -name .vite -o -name __pycache__ -o -name .pytest_cache \
      -o -name .mypy_cache -o -name .ruff_cache \) -prune -print0 2>/dev/null)
  done
}

clean_containers() {
  [[ "$CONTAINERS" == 1 ]] || return 0
  has docker && run docker system prune -f # no --volumes, no -a
  has podman && run podman system prune -f
}

main() {
  clean_pkg_caches
  clean_stale_snaps
  clean_logs
  clean_trash
  clean_lang_caches
  clean_user_cache
  clean_flatpak
  clean_projects
  clean_containers
  clean_targets
  echo "sweep done${DRY:+ (dry run - nothing was removed)}"
  return "$FAILED"
}

main

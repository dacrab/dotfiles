#!/usr/bin/env bash
# update-bun — topgrade step replacing the built-in, which runs `bun upgrade`
# without a token and fails with HTTPForbidden once the shared 60/hour GitHub
# quota is spent. The token has to be exported by this process: topgrade gives
# no way to inject a variable into a step.
set -euo pipefail

if command -v gh >/dev/null && [ -z "${GITHUB_TOKEN:-}${GITHUB_ACCESS_TOKEN:-}" ]; then
  if token=$(gh auth token 2>/dev/null) && [ -n "$token" ]; then
    export GITHUB_TOKEN="$token"
  fi
fi

# `bun upgrade` exits non-zero when already current, so it is compared here.
current=$(bun --version)
bun upgrade
latest=$(bun --version)

if [ "$current" = "$latest" ]; then
  echo "bun $latest: up-to-date"
else
  echo "bun: $current -> $latest"
fi

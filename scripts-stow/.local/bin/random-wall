#!/usr/bin/env bash
# Set a random wallpaper, different from last time. See `random-wall --help`.
set -uo pipefail

usage() {
  cat <<'EOF'
Usage: random-wall [--autostart] [--keep] [<dir>]
  no args      pick from $WALLPAPER_DIR/nord
  <dir>        path, or a name under $WALLPAPER_DIR
  --autostart  login mode: exit quietly when Hyprland is already running this
  --keep       re-apply the wallpaper used last time instead of picking a new
               one (use after enabling a monitor)
EOF
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
esac

AUTO=0
if [[ "${1:-}" == --autostart ]]; then
  AUTO=1
  shift
fi
KEEP=0
if [[ "${1:-}" == --keep ]]; then
  KEEP=1
  shift
fi
if (($# > 1)); then
  echo "random-wall: too many arguments" >&2
  exit 2
fi

# Hyprland autostarts this script itself; running twice would race hyprpaper IPC.
if [[ "$AUTO" == 1 ]] && pgrep -x Hyprland &>/dev/null; then
  exit 0
fi

BASE="${WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
WALL_EXT="${WALL_EXT:-jpg jpeg png webp}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/random-wall"

wall_dir=${1:-nord}
[[ "$wall_dir" == */* ]] || wall_dir="$BASE/$wall_dir"
DIR=$(realpath -e -- "$wall_dir" 2>/dev/null) || {
  echo "no wallpapers dir: $wall_dir" >&2
  exit 1
}

read -ra exts <<<"$WALL_EXT"
if ((${#exts[@]} == 0)); then
  echo "WALL_EXT must contain at least one extension" >&2
  exit 1
fi
name_args=()
for ext in "${exts[@]}"; do
  name_args+=(-o -iname "*.$ext")
done
mapfile -d '' ALL < <(find "$DIR" -type f \( "${name_args[@]:1}" \) -print0)
if ((${#ALL[@]} == 0)); then
  echo "no images in $DIR" >&2
  exit 1
fi

LAST=$(cat "$STATE/last" 2>/dev/null || true)

# Pool excludes LAST so consecutive runs differ when possible.
found=0
POOL=()
for img in "${ALL[@]}"; do
  if [[ "$img" == "$LAST" ]]; then
    found=1
  else
    POOL+=("$img")
  fi
done

if [[ "$KEEP" == 1 && "$found" == 1 && -f "$LAST" ]]; then
  PICK="$LAST"
else
  ((${#POOL[@]} > 0)) || POOL=("${ALL[@]}")
  PICK="${POOL[RANDOM % ${#POOL[@]}]}"
fi

set_hyprland() {
  local runtime sock status=0 names=() name
  runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  for _ in {1..50}; do
    sock=$(find "$runtime/hypr" -maxdepth 2 -name .hyprpaper.sock -print -quit 2>/dev/null) || return 1
    [[ -n "$sock" ]] && break
    sleep 0.1
  done
  [[ -n "${sock:-}" ]] || return 1
  # `monitors` alone lists only enabled outputs; filtering `all` makes the
  # disabled-panel check explicit. A missing jq or hyprctl yields no names.
  mapfile -t names < <(hyprctl -j monitors all 2>/dev/null | jq -r '.[] | select(.disabled == false) | .name' 2>/dev/null)
  ((${#names[@]} > 0)) || return 1
  for name in "${names[@]}"; do
    hyprctl hyprpaper wallpaper "$name,$1" || status=1
  done
  return "$status"
}

# Also covers Budgie (uses org.gnome.desktop).
set_gsettings() {
  local schema=$1 img=$2
  gsettings set "$schema" picture-uri "file://$img" || return 1
  gsettings set "$schema" picture-uri-dark "file://$img"
}

set_xfce() {
  local screens props scr prop status=0
  screens=$(xfconf-query -c xfce4-desktop -p /backdrop/screens -l 2>/dev/null) || return 1
  while IFS= read -r scr; do
    [[ -n "$scr" ]] || continue
    if ! props=$(xfconf-query -c xfce4-desktop -p "$scr" -l 2>/dev/null); then
      status=1
      continue
    fi
    while IFS= read -r prop; do
      [[ "$prop" == *"/last-image" ]] || continue
      xfconf-query -c xfce4-desktop -p "$prop" -s "$1" || status=1
    done <<<"$props"
  done <<<"$screens"
  xfconf-query -c xfce4-desktop -p /backdrop/single-image -s "$1" &>/dev/null || status=1
  return "$status"
}

set_swaybg() {
  command -v swaybg >/dev/null 2>&1 || return 1
  pkill -x swaybg &>/dev/null || true
  sleep 0.2
  nohup swaybg -m fill -i "$1" &>/dev/null &
}

detect_desktop() {
  case "${XDG_CURRENT_DESKTOP:-}" in
  *Hyprland*) echo hyprland ;;
  *GNOME*) echo gnome ;;
  *Cinnamon*) echo cinnamon ;;
  *MATE*) echo mate ;;
  *XFCE*) echo xfce ;;
  *sway* | *wlroots*) echo sway ;;
  *)
    if pgrep -x Hyprland &>/dev/null; then
      echo hyprland
    elif pgrep -x gnome-shell &>/dev/null; then
      echo gnome
    elif pgrep -x sway &>/dev/null; then
      echo sway
    elif pgrep -x xfce4-session &>/dev/null; then
      echo xfce
    fi
    ;;
  esac
}

write_state() {
  local tmp
  if ! mkdir -p "$STATE"; then
    echo "random-wall: cannot create state directory: $STATE" >&2
    return 1
  fi
  if ! tmp=$(mktemp "$STATE/.last.XXXXXX"); then
    echo "random-wall: cannot create temporary state file" >&2
    return 1
  fi
  if printf '%s' "$PICK" >"$tmp" && mv -f -- "$tmp" "$STATE/last"; then
    return 0
  fi
  rm -f -- "$tmp"
  echo "random-wall: cannot write state: $STATE/last" >&2
  return 1
}

case "$(detect_desktop)" in
hyprland) set_hyprland "$PICK" || exit 1 ;;
gnome) set_gsettings org.gnome.desktop.background "$PICK" || exit 1 ;;
cinnamon) set_gsettings org.cinnamon.desktop.background "$PICK" || exit 1 ;;
mate) gsettings set org.mate.background picture-filename "$PICK" || exit 1 ;;
xfce) set_xfce "$PICK" || exit 1 ;;
sway) set_swaybg "$PICK" || exit 1 ;;
*)
  echo "unsupported desktop" >&2
  exit 1
  ;;
esac

write_state || exit 1

#!/usr/bin/env bash
# update-gearlever-release <owner/repo> [<asset glob>]
# Prints "<tag>\t<asset URL>" for the newest matching release asset, using the
# public release pages rather than the REST API (no shared quota).
set -euo pipefail

repo=${1:?usage: update-gearlever-release <owner/repo> [<asset name or glob>]}
asset=${2:-*}
url=https://github.com

tag=$(curl -fsSL --retry 2 --max-time 30 -o /dev/null -w '%{url_effective}' \
    "$url/$repo/releases/latest" |
  sed -n 's#.*/releases/tag/##p')
[ -n "$tag" ] || exit 1

asset_url=$(curl -fsSL --retry 2 --max-time 30 \
    "$url/$repo/releases/expanded_assets/$tag" |
  grep -oE "href=\"[^\"]*/releases/download/$tag/[^\"]+\"" |
  sed -e 's/^href="//' -e 's/"$//' |
  while read -r candidate; do
    # shellcheck disable=SC2254 # glob is intentional
    case "${candidate##*/}" in $asset) echo "$url$candidate" ;; esac
  done | tail -1)
[ -n "$asset_url" ] || exit 1

printf '%s\t%s\n' "$tag" "$asset_url"

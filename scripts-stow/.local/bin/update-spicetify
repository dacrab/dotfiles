#!/usr/bin/env bash
# update-spicetify — topgrade step replacing the built-in, whose
# `spicetify upgrade` hits api.github.com anonymously and silently does nothing
# once the shared 60/hour quota is spent. Here the version check uses the
# public releases/latest redirect and the download goes through `gh`.
set -euo pipefail

repo=spicetify/cli
dest=$HOME/.spicetify
gh_bin=$(command -v gh || true)

work=$(mktemp -d "${TMPDIR:-/tmp}/update-spicetify.XXXXXX")
trap 'rm -rf "$work"' EXIT

current=$(spicetify -q --version 2>/dev/null || true)
current=${current%% *}

tag=$(curl -fsSL --retry 2 --max-time 30 -o /dev/null -w '%{url_effective}' \
    "https://github.com/$repo/releases/latest" |
  sed -n 's#.*/releases/tag/v\{0,1\}##p')
if [ -z "$tag" ]; then
  echo "error: could not determine the latest $repo release" >&2
  exit 1
fi
latest=${tag#v}

if [ "$current" = "$latest" ]; then
  echo "spicetify $latest: up-to-date"
else
  echo "spicetify: ${current:-unknown} -> $latest"
  if [ -z "$gh_bin" ]; then
    echo "error: gh is required to download the release without hitting the rate limit" >&2
    exit 1
  fi
  "$gh_bin" release download "v$latest" --repo "$repo" \
    --pattern 'spicetify-*-linux-amd64.tar.gz' --dir "$work"
  # The archive holds the spicetify binary at its root.
  tar -xzf "$work"/spicetify-*-linux-amd64.tar.gz -C "$work"
  install -m 0755 "$work/spicetify" "$dest/spicetify"
  echo "installed spicetify $latest to $dest/spicetify"
fi

# Apply from a config copy with the update check off, so the API is never
# queried and ~/.config/spicetify stays untouched. A stale backup is not a
# failure: the theme still applies. The hint below is not cosmetic — until the
# backup is rebuilt, every run takes this branch and the theme is never really
# refreshed. No sudo: the Flatpak Apps/ dir is user-writable.
mkdir -p "$work/config"
cp -a "$HOME/.config/spicetify/." "$work/config/"
sed -i 's/^check_spicetify_update[[:space:]]*=.*/check_spicetify_update = 0/' \
  "$work/config/config-xpui.ini"
if ! out=$(SPICETIFY_CONFIG="$work/config" spicetify apply 2>&1); then
  printf '%s\n' "$out"
  case "$out" in
    *"Preprocessed Spotify data is outdated"*)
      echo "note: the backup predates the installed Spotify build; run" >&2
      echo "      $dest/spicetify restore backup apply" >&2
      ;;
    *) exit 1 ;;
  esac
fi
echo "spicetify: theme applied"

// Local overrides, merged over `vicinae config default`.

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "font": {
      "normal": {
         "family": "GeistMono Nerd Font Mono",
         "size": 10
      }
   },
   "theme": {
      "dark": {
         "name": "nord",
         "icon_theme": "Papirus-Dark"
      }
   },
   "favorites": [
      "applications:com.spotify.Client",
      "applications:helium"
   ],
   "providers": {
      "@Gelei/store.vicinae.bluetooth": {
         "enabled": false
      },
      "@LuggaPugga/store.vicinae.port-killer": {
         "enabled": false
      },
      "@OmerMohideen/store.vicinae.custom-commands": {
         "enabled": false
      },
      "@botkooper/store.vicinae.power-profile": {
         "enabled": false
      },
      "@dagimg-dot/store.vicinae.wifi-commander": {
         "enabled": false
      },
      "snippets": {
         "preferences": {
            "enabled": true,
            "undo": true,
            "layout": "",
            "prePasteDelay": "0",
            "keyDelay": "2"
         }
      }
   }
}

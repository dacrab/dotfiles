{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark/dark",
  "defaultProvider": "opencode",
  "defaultModel": "space-bunny-free",
  "enabledModels": [
    "opencode/space-bunny-free"
  ],
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-lens",
    "npm:pi-web-access",
    "npm:pi-subagents"
  ],
  "thinkingBudgets": {
    "minimal": 1024,
    "low": 4096,
    "medium": 10240,
    "high": 32768
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "hideThinkingBlock": true
}